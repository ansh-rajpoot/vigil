# ==============================================================================
# VIGIL — Smart Tourist Safety & Incident Response System
# Environment Configuration Template (Render & Production Ready)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SECURITY & RUNTIME
# ------------------------------------------------------------------------------
# Set DEBUG=False in production.
DEBUG=False

# Generate a strong 50+ character random key in production. Never commit the actual key!
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# Comma-separated list of allowed hostnames. Render domains (*.onrender.com) are auto-included.
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost

# Port provided automatically by Render ($PORT)
PORT=8000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (Primary & Mandatory Engine)
# ------------------------------------------------------------------------------
# Option A: Full Connection String (Auto-provided by Render PostgreSQL)
DATABASE_URL=postgresql://vigil_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/vigil_db

# Option B: Discrete Parameters (for local development or Docker)
DB_NAME=vigil_db
DB_USER=vigil_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. DJANGO CHANNELS & WEBSOCKET ENGINE
# ------------------------------------------------------------------------------
# Use 'inmemory' for single-worker or attach Render Redis for multi-instance scaling
CHANNEL_LAYER_BACKEND=inmemory
REDIS_URL=
# Example Redis: REDIS_URL=rediss://default:password@red-xxxxxx:6379

# ------------------------------------------------------------------------------
# 4. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-service.onrender.com,http://localhost:8000
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://your-service.onrender.com,http://localhost:8000

# ------------------------------------------------------------------------------
# 5. HTTPS & REVERSE PROXY SECURITY (Enable in Production)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 6. STATIC ASSETS & MEDIA STORAGE
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/
